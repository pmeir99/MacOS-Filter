{
  "manifest_version": 3,
  "name": "MacOS Filter",
  "version": "0.4.0",
  "description": "On-device image filtering through the MacOS Filter app.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MacOS Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/filter-16.png",
      "32": "icons/filter-32.png",
      "48": "icons/filter-48.png",
      "128": "icons/filter-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "key": "",
  "icons": {
    "16": "icons/filter-16.png",
    "32": "icons/filter-32.png",
    "48": "icons/filter-48.png",
    "128": "icons/filter-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
