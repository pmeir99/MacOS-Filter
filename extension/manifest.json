{
  "manifest_version": 3,
  "name": "MacOS Filter",
  "version": "0.3.0",
  "description": "On-device image filtering through the MacOS Filter app.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MacOS Filter",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "rules.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}